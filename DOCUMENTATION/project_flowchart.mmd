    classDef stage1 fill:#E8F4FD,stroke:#0B5FFF,color:#1a1a1a,font-size:12px;
    classDef stage2 fill:#FFF0E8,stroke:#FF6B35,color:#1a1a1a,font-size:12px;
    classDef stage3 fill:#E8F8E8,stroke:#2ECC71,color:#1a1a1a,font-size:12px;
    classDef sup fill:#F3E5F5,stroke:#9C27B0,color:#1a1a1a,font-size:12px;
    classDef out fill:#FFFDE7,stroke:#FBC02D,color:#1a1a1a,font-size:12px;

    linkStyle default stroke:#666,stroke-width:2px;
    linkStyle 0,1,2,3,4 stroke:#0B5FFF,stroke-width:3px;